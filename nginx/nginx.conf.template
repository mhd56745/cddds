# =====================================================================
#  koyeb-tv — محطة تلفزية خفيفة على nginx فقط (بدون ffmpeg)
#  لوحة تحكم بأسلوب Viloud: قنوات VOD بقوائم تشغيل متكررة 24/7 عبر
#  nginx-vod-module (mapped + live) + قنوات إعادة بث خارجية (HLS/TS).
#  مواقع القنوات تُولَّد آلياً في channel_locations.conf من لوحة التحكم.
#  المتغيرات أدناه تُستبدل بـ envsubst عند إقلاع الحاوية (entrypoint.sh)
# =====================================================================

worker_processes 1;
worker_rlimit_nofile 65535;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    include mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 30s;
    server_tokens off;

    # سجلات خفيفة تناسب الخطة المجانية (لا نكتب سجل دخول إطلاقاً)
    access_log off;
    error_log ${ERROR_LOG} warn;

    # ضغط قوائم التشغيل (نصوص صغيرة، تكلفة معدومة)
    gzip on;
    gzip_comp_level 4;
    gzip_min_length 256;
    gzip_types application/vnd.apple.mpegurl application/x-mpegurl application/json text/plain text/javascript;

    # كاش وحدة vod في الذاكرة المشتركة — يوفّر المعالج والقرص
    # (كاش ذرات moov للملفات + كاش خريطة البث الحي لمدة 30 ث + كاش قوائم 2 ث)
    vod_metadata_cache meta_cache 64m 24h;
    vod_live_mapping_cache live_map 8m 30s;
    vod_live_response_cache live_resp 8m 2s;

    # كاش مقابض الملفات — يقلل استدعاءات النظام
    open_file_cache max=1000 inactive=5m;
    open_file_cache_valid 2m;
    open_file_cache_min_uses 1;
    open_file_cache_errors on;

    # Koyeb يفصل TLS قبله — نعيد بناء المخطط الصحيح للروابط المطلقة في القوائم:
    # إن وجدت ترويسة X-Forwarded-Proto نستخدمها، وإلا http (تشغيل محلي مباشر)
    map $http_x_forwarded_proto $tv_proto {
        "https"  "https";
        ""       "http";
        default  "http";
    }

    server {
        listen ${PORT};
        server_name _;

        # طلبات الاستيراد/التصدير في اللوحة صغيرة — حد سخي احتياطاً
        client_max_body_size 8m;

        # ---------- فحص صحة Koyeb ----------
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        # ---------- الملفات الداخلية لخرائط البث (لا تُفتح من الخارج) ----------
        location ^~ /map/ {
            internal;
            alias ${MAPS_DIR}/;
            # الخريطة تُكتب من جديد كل بضع ثوان — يجب قراءتها طازجة دائماً
            open_file_cache off;
        }

        # =====================================================
        #  مواقع القنوات (VOD + إعادة البث) — مولَّدة آلياً من
        #  لوحة التحكم عبر gen_locations.py، ومع كل تعديل يُعاد
        #  توليدها ثم nginx -s reload
        #  قناة VOD:  /live/<id>/master.m3u8
        #  قناة HLS:  /restream/<id>/<مسار القائمة>
        #  قناة TS:   /restream/<id>/stream.ts
        # =====================================================
        include ${CHANNELS_CONF};

        # =====================================================
        #  واجهة لوحة التحكم البرمجية — بايثون خلف nginx
        # =====================================================
        location ^~ /api/ {
            proxy_pass http://127.0.0.1:${ADMIN_PORT};
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $tv_proto;
            proxy_connect_timeout 5s;
            proxy_read_timeout 300s;
        }

        # ---------- صفحات اللوحة والمشغل (ملفات ثابتة) ----------
        location = /admin  { return 302 /admin/; }
        location ^~ /admin/ { root ${WWW_DIR}; try_files /admin.html =404; }
        location ^~ /watch/ { root ${WWW_DIR}; try_files /watch.html =404; }
        location ^~ /embed/ { root ${WWW_DIR}; try_files /embed.html =404; }

        # ---------- صفحة القنوات الرئيسية ----------
        location / {
            root ${WWW_DIR};
            index index.html;
        }
    }
}
